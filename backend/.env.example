# Database PostgreSQL (Supabase)
DB_USER=your_supabase_db_user
DB_HOST=your_supabase_db_host
DB_NAME=postgres
DB_PASSWORD=your_supabase_db_password
DB_PORT=6543

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# JWT Secret (ganti dengan string acak yang kuat di production!)
JWT_SECRET=ganti_dengan_secret_key_yang_kuat_dan_acak

# CORS Origins (pisahkan dengan koma)
CORS_ORIGIN=http://localhost:5173,https://aurumvice.vercel.app
